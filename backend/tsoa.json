{
  "entryFile": "src/app.ts",
  "controllerPathGlobs": ["src/controllers/*-controller.ts"],
  "noImplicitAdditionalProperties": "ignore",
  "spec": {
    "outputDirectory": "src/generated",
    "specVersion": 3,
    "name": "MCPWatch dashboard API",
    "securityDefinitions": {
      "session": { "type": "apiKey", "in": "cookie", "name": "mw_session" },
      "projectKey": { "type": "apiKey", "in": "header", "name": "x-mcpwatch-key" }
    }
  },
  "routes": {
    "routesDir": "src/generated",
    "middleware": "express",
    "esm": true,
    "authenticationModule": "./src/http/authentication.ts",
    "iocModule": "./src/http/ioc.ts"
  }
}
