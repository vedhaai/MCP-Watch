{
  "name": "@vedhaai/mcpwatch-dashboard",
  "version": "0.3.0",
  "description": "MCPWatch dashboard: projects, keys and the requests your MCP servers' guards report",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "dashboard"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vedhaai/MCP-Watch.git",
    "directory": "backend"
  },
  "homepage": "https://github.com/vedhaai/MCP-Watch#readme",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "mcpwatch-dashboard": "dist/cli.js"
  },
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "build": "tsoa spec-and-routes && tsc",
    "start": "node dist/cli.js",
    "dev": "npm run build && concurrently -k -n build,server -c cyan,green \"nodemon --watch src --ext ts --ignore src/generated --on-change-only --exec \\\"npm run build\\\"\" \"nodemon --watch dist --watch ../engine/dist --ext js --delay 1 dist/cli.js\"",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run build --prefix ../frontend && npm test"
  },
  "license": "MIT",
  "dependencies": {
    "@tsoa/runtime": "^6.6.0",
    "@vedhaai/mcpwatch": "^0.2.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "concurrently": "^9.2.5",
    "nodemon": "^3.1.14",
    "tsoa": "^6.6.0",
    "typescript": "^7.0.2"
  }
}
