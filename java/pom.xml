<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>ai.vedha</groupId>
  <artifactId>mcpwatch</artifactId>
  <version>0.1.1</version>
  <packaging>jar</packaging>

  <name>MCPWatch for Java</name>
  <description>Security guard for MCP servers written in Java: every JSON-RPC message between any
    client and your server is checked by the MCPWatch engine.</description>
  <url>https://github.com/vedhaai/MCP-Watch</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <!--
    The groupId's own domain. Beyond being the right metadata, this is the only lever the POM
    offers over the icon that directory sites (mvnrepository.com and the like) show beside an
    artifact: those icons are the publishing organisation's brand, keyed to its site, not
    per-artifact art. The Maven 4.0.0 model has no <logo> element - Maven 1 had one and it was
    dropped - so nothing here sets an image directly.
  -->
  <organization>
    <name>vedhaai</name>
    <url>https://vedha.ai</url>
  </organization>

  <!-- Maven Central requires a developer entry; npm and PyPI infer it from the account. -->
  <developers>
    <developer>
      <id>vedhaai</id>
      <name>vedhaai</name>
      <url>https://github.com/vedhaai</url>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/vedhaai/MCP-Watch</url>
    <connection>scm:git:https://github.com/vedhaai/MCP-Watch.git</connection>
    <developerConnection>scm:git:git@github.com:vedhaai/MCP-Watch.git</developerConnection>
  </scm>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- The official MCP Java SDK and the servlet API are "provided": your server already has them,
         and MCPWatch must never force a version on it. -->
    <mcp.version>2.1.0</mcp.version>
    <servlet.version>6.0.0</servlet.version>
    <reactor.version>3.7.4</reactor.version>
    <slf4j.version>2.0.16</slf4j.version>
    <junit.version>5.11.4</junit.version>
    <jetty.version>12.0.16</jetty.version>
  </properties>

  <dependencies>
    <!-- Logging only; the guard has no runtime dependency of its own. JSON is handled by the
         package's own codec (ai.vedha.mcpwatch.Json) so it can never clash with the host app's. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>

    <!-- Needed only by the SDK wrapper (McpWatch.guard). Servers that use the servlet filter alone
         never load these classes. -->
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp</artifactId>
      <version>${mcp.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.projectreactor</groupId>
      <artifactId>reactor-core</artifactId>
      <version>${reactor.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Needed only by McpWatchFilter. -->
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <version>${servlet.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- A real servlet container, so McpWatchFilter is tested through actual HTTP rather than mocks:
         response buffering, Content-Length and SSE streaming only misbehave in a real one. -->
    <dependency>
      <groupId>org.eclipse.jetty.ee10</groupId>
      <artifactId>jetty-ee10-servlet</artifactId>
      <version>${jetty.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <environmentVariables>
            <!--
              The engine for tests that build their own Engine from init parameters, where no
              McpWatchOptions can carry the command. This checkout's engine, never npx, so a test
              never reaches the network. Tests that pass engineCommand themselves ignore this, and
              TestEngine.requireEngine() skips them all when engine/dist/cli.js is missing.
            -->
            <MCPWATCH_ENGINE>node "${project.basedir}/../engine/dist/cli.js"</MCPWATCH_ENGINE>
          </environmentVariables>
        </configuration>
      </plugin>
      <!-- Central requires a sources jar and a javadoc jar alongside the main one. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals><goal>jar-no-fork</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.11.2</version>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals><goal>jar</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Publishing to Maven Central: `mvn -Prelease deploy`.

      Kept in a profile so an ordinary `mvn test` or `mvn install` needs no GPG key. Unlike npm and
      PyPI, Central requires every artifact to be signed, and requires the `ai.vedha` namespace to
      be verified once before the first deploy. See "Publishing" in README.md.
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <!--
              Keep this current. The Central API evolves, and older plugin builds fail on fields
              they don't know: 0.7.0 dies with `Unrecognized field "warnings"` while reading the
              status response, after the upload has already succeeded.
            -->
            <version>0.12.0</version>
            <extensions>true</extensions>
            <configuration>
              <!-- The server id in ~/.m2/settings.xml holding the Central Portal token. -->
              <publishingServerId>central</publishingServerId>
              <!-- Upload and wait, but let a person press publish after checking the staged files,
                   the way `npm publish` is run by hand here. Set to "automatic" to skip that. -->
              <autoPublish>false</autoPublish>
              <waitUntil>validated</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
